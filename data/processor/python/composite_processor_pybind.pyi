from typing import Any, Dict, List, Optional, Tuple, Union

import numpy as np

import .google.protobuf.any_pb2 as any_pb2
from .third_party.neptune.data.processor.proto import transform_config_pb2

TransformConfig = transform_config_pb2.TransformConfig
CompositeProcessorConfig = transform_config_pb2.CompositeProcessorConfig

class TypeInfo:
  def debug_type_name(self) -> str: ...
  def __repr__(self) -> str: ...
  def __eq__(self, other: Any) -> bool: ...
  @staticmethod
  def int() -> 'TypeInfo': ...
  @staticmethod
  def float() -> 'TypeInfo': ...
  @staticmethod
  def string() -> 'TypeInfo': ...
  @staticmethod
  def host_buffer() -> 'TypeInfo': ...
  @staticmethod
  def host_buffer_vector() -> 'TypeInfo': ...
  @staticmethod
  def protobuf_any() -> 'TypeInfo': ...

class HostBuffer:
  @staticmethod
  def create_int64_array(
      vals: List[int], shape: Optional[List[int]] = None
  ) -> 'HostBuffer': ...
  @staticmethod
  def create_string_array(
      vals: List[str], shape: Optional[List[int]] = None
  ) -> 'HostBuffer': ...
  @staticmethod
  def create_from_bytes_object_ndarray(arr: np.ndarray) -> 'HostBuffer': ...
  @staticmethod
  def create_int64(val: int) -> 'HostBuffer': ...
  @staticmethod
  def create_int32(val: int) -> 'HostBuffer': ...
  @staticmethod
  def create_string(val: str) -> 'HostBuffer': ...
  @staticmethod
  def create_bytes_array(
      vals: List[bytes], shape: Optional[List[int]] = None
  ) -> 'HostBuffer': ...
  @staticmethod
  def from_dlpack(obj: object, copy: Optional[bool] = None) -> 'HostBuffer': ...
  def to_int64(self) -> int: ...
  def to_int32(self) -> int: ...
  def to_float(self) -> float: ...
  def to_double(self) -> float: ...
  def to_string(self) -> bytes: ...
  def to_string_array(self) -> List[Any]: ...
  def get_ref_count(self) -> int: ...
  @property
  def dtype(self) -> np.dtype: ...
  @property
  def shape(self) -> Tuple[int, ...]: ...
  @property
  def storage_dtype(self) -> np.dtype: ...
  def __dlpack_device__(self) -> Tuple[int, int]: ...
  def __dlpack__(
      self,
      stream: Optional[object] = None,
      max_version: Optional[object] = None,
      dl_device: Optional[object] = None,
      copy: Optional[object] = None,
  ) -> object: ...

class Value:
  @overload
  def __init__(self) -> None: ...
  @overload
  def __init__(
      self,
      val: Union[
          int, float, str, HostBuffer, list[HostBuffer], dict[str, HostBuffer], any_pb2.Any
      ],
  ) -> None: ...
  def is_empty(self) -> bool: ...
  def type_info(self) -> TypeInfo: ...
  def as_encapsulated_type(
      self,
  ) -> Union[
      int, float, str, HostBuffer, list[HostBuffer], dict[str, HostBuffer], any_pb2.Any
  ]: ...

class ExecuteMetadata:
  model_name: str
  model_version: int
  trace_id: int
  def __init__(self) -> None: ...

class HostBufferSpec:
  @property
  def dtype(self) -> Any: ...
  @property
  def shape(self) -> Tuple[int, ...]: ...
  def __init__(self, dtype: Any, shape: List[int]) -> None: ...

class ShapeInferenceValue:
  def is_spec(self) -> bool: ...
  def spec(self) -> HostBufferSpec: ...
  def is_spec_list(self) -> bool: ...
  def spec_list(self) -> List[HostBufferSpec]: ...
  def __init__(self, val: Optional[Union[HostBufferSpec, List[HostBufferSpec]]] = ...) -> None: ...

class ShapeInferenceContext:
  metadata: ExecuteMetadata
  inputs: List[ShapeInferenceValue]
  outputs: List[ShapeInferenceValue]
  def __init__(self) -> None: ...

class ExecuteContext:
  metadata: ExecuteMetadata
  inputs: List[Value]
  outputs: List[Value]
  def __init__(self) -> None: ...

class TransformBase:
  @property
  def name(self) -> str: ...
  def __repr__(self) -> str: ...
  def __init__(self) -> None: ...
  def execute(self, context: ExecuteContext) -> None: ...
  def propagate_signature(self, context: ShapeInferenceContext) -> None: ...
  def input_types(self) -> List[TypeInfo]: ...
  def output_types(self) -> List[TypeInfo]: ...
  def input_constraints(self) -> List[Dict[str, Any]]: ...
  def to_proto(self) -> TransformConfig: ...
  def assets(self) -> Dict[str, str]: ...
  @staticmethod
  def from_proto(config: TransformConfig) -> 'TransformBase': ...

class GraphEdge:
  @staticmethod
  def graph_input(index: int) -> 'GraphEdge': ...
  @staticmethod
  def node_output(node_index: int, port_index: int = 0) -> 'GraphEdge': ...
  @staticmethod
  def constant(value: Value) -> 'GraphEdge': ...

class ExecutionGraph:
  def __init__(self) -> None: ...
  def add_transform(
      self, name: str, transform: Union[str, 'TransformBase']
  ) -> None: ...
  def add_node(
      self,
      name: str,
      transform: Union[str, 'TransformBase'],
      input_edges: List[GraphEdge],
  ) -> int: ...
  def set_outputs(self, outputs: List[GraphEdge]) -> None: ...
  @property
  def io_structure(self) -> Any: ...
  @io_structure.setter
  def io_structure(self, value: Any) -> None: ...

class CompositeProcessor:
  @staticmethod
  def from_proto(config: CompositeProcessorConfig) -> 'CompositeProcessor': ...
  @staticmethod
  def create(graph: ExecutionGraph) -> 'CompositeProcessor': ...
  def to_proto(self) -> CompositeProcessorConfig: ...
  def process(self, inputs: List[Value]) -> List[Value]: ...
  def propagate_signature(self, context: ShapeInferenceContext) -> None: ...
  @property
  def graph(self) -> ExecutionGraph: ...
