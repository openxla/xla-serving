from typing import List, overload
from data.resource_manager.proto import resource_manager_pb2

class CppAsset:
  name: str
  path: str
  content: str
  @overload
  def __init__(self, name: str, path: str) -> None: ...
  @overload
  def __init__(self, name: str, path: str, content: str) -> None: ...
  def load_content(self) -> None: ...

class CppResource:
  name: str
  id: int
  class_name: str
  assets: List[CppAsset]
  @overload
  def __init__(self) -> None: ...
  @overload
  def __init__(self, assets: List[CppAsset]) -> None: ...
  @overload
  def __init__(self, name: str, assets: List[CppAsset], class_name: str) -> None: ...
  @overload
  def __init__(self, id: int, name: str, assets: List[CppAsset], class_name: str) -> None: ...
  def load(self) -> None: ...
  def LoadImpl(self) -> None: ...

class CppResourceManager:
  @overload
  def __init__(self) -> None: ...
  def add_resource(self, resource: CppResource) -> None: ...
  def add_resource_ignoring_duplicates(self, resource: CppResource) -> None: ...
  def get_resource(self, resource_id: int) -> CppResource: ...
  def get_all_assets(self) -> List[CppAsset]: ...
  def get_all_resources(self) -> List[CppResource]: ...
  def to_proto(self) -> resource_manager_pb2.ResourceManagerProto: ...
  @staticmethod
  def from_proto(
      proto: resource_manager_pb2.ResourceManagerProto,
  ) -> CppResourceManager: ...
  @staticmethod
  def create(resources: List[CppResource]) -> CppResourceManager: ...
