# To calculate integrity:
# wget -O temp_module_archive.tar.gz <archive URL>
# HASH=$(openssl dgst -sha256 -binary temp_module_archive.tar.gz | openssl base64 -A)
# echo "sha256-${HASH}"
bazel_dep(name = "rules_ml_toolchain")
archive_override(
    module_name = "rules_ml_toolchain",
    integrity = "sha256-koXZBgF1eDjQZKEvUfFDdNQAZN3C+hmJeZCLa9D4k0g=",
    patch_strip = 1,
    patches = [
        "//third_party/rules_ml_toolchain:patch_nvcc_wrapper.patch",
    ],
    strip_prefix = "rules_ml_toolchain-7f40603f574b95746152332ef3ad5fce63f1768d",
    urls = ["https://github.com/google-ml-infra/rules_ml_toolchain/archive/7f40603f574b95746152332ef3ad5fce63f1768d.tar.gz"],
)

bazel_dep(name = "xla")
archive_override(
    module_name = "xla",
    integrity = "sha256-bX4lJ6rIWNvofqlLzr1pToQFuVf6txImf2f5rrGAbFY=",
    patch_strip = 1,
    patches = [
        "//third_party/xla:xla_bzlmod_llvm.patch",
        "//third_party/xla:xla_python_3_12.patch",
    ],
    strip_prefix = "xla-9ab1e95548ebf46a765ef97e3344295d89102549",
    urls = ["https://github.com/openxla/xla/archive/9ab1e95548ebf46a765ef97e3344295d89102549.tar.gz"],
)

