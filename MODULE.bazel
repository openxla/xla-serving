# To calculate integrity:
# wget -O temp_module_archive.tar.gz <archive URL>
# HASH=$(openssl dgst -sha256 -binary temp_module_archive.tar.gz | openssl base64 -A)
# echo "sha256-${HASH}"
bazel_dep(name = "rules_ml_toolchain")
archive_override(
    module_name = "rules_ml_toolchain",
    integrity = "sha256-Z38HhfFL91M5oxh8un+pXhofiIoYVo7cLl+sh9UT/Hw=",
    patch_strip = 1,
    patches = [
        "//third_party/rules_ml_toolchain:patch_nvcc_wrapper.patch",
    ],
    strip_prefix = "rules_ml_toolchain-f56a19573fec3543050a5f4bcd9a07a1de08e8ee",
    urls = ["https://github.com/google-ml-infra/rules_ml_toolchain/archive/f56a19573fec3543050a5f4bcd9a07a1de08e8ee.tar.gz"],
)

# The XLA dependency and its pinned revision live in a separate file so that the
# revision can be updated automatically without touching this file.
include("//third_party/xla:xla.MODULE.bazel")

xla_third_party = use_extension("@xla//third_party/extensions:third_party.bzl", "third_party_ext")

# Use a single nanobind for XLA and for our own extensions, otherwise both
# copies get linked into the same extension module.
nanobind_internal = use_extension("@nanobind_bazel//:internal_configure.bzl", "internal_configure_extension")
use_repo(nanobind_internal, "nanobind")

override_repo(
    xla_third_party,
    nanobind = "nanobind",
    riegeli = "riegeli",
)

## Tensorflow dependencies for common runtime, Tensor etc.
# To calculate integrity:
# wget -O temp_module_archive.zip
# HASH=$(openssl dgst -sha256 -binary temp_module_archive.zip | openssl base64 -A)
# echo "sha256-${HASH}"
bazel_dep(name = "tensorflow", repo_name = "org_tensorflow")
archive_override(
    module_name = "tensorflow",
    integrity = "sha256-UbjfYA4j4P+lCvGwfcEt05e18J8mlJ+PfDePC9zjD94=",
    patch_strip = 1,
    patches = [
        # Restores the `//tensorflow/core:framework` dep of
        # `//tensorflow/core/kernels/batching_util:warmup`, which upstream
        # switched to `framework_headers_lib`. The header-only library doesn't
        # propagate the include paths of Eigen and protobuf when TensorFlow is
        # an external module, so `warmup.cc` fails to compile.
        "//third_party/tensorflow:warmup_framework_dep.patch",
        "//third_party/tensorflow:where_op_gpu.patch",
    ],
    strip_prefix = "tensorflow-fa441ca48d3262b4938ee2a9ed6d560cdf5f3b13",
    urls = ["https://github.com/tensorflow/tensorflow/archive/fa441ca48d3262b4938ee2a9ed6d560cdf5f3b13.zip"],
)

tf_third_party = use_extension("@org_tensorflow//third_party/extensions:third_party.bzl", "third_party_ext")
use_repo(tf_third_party, "tf_runtime")

single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = ["//third_party/grpc:grpc.patch"],
    version = "1.81.0",
)

single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = [
        # These patches are in XLA repo as well, we need to still
        # apply them here for build to succeed.
        "//third_party/protobuf:protobuf_arena.patch",
        "//third_party/protobuf:fix_message_lite_incomplete_type.patch",
        # The following patch is needed to fix package loading for `bazel query "deps(//xla/...)"`.
        "//third_party/protobuf:fix_python_dist_package.patch",
        # Makes `//python:proto_api` use the headers of the selected Python
        # toolchain instead of Python 3.12. Already fixed in upstream main.
        "//third_party/protobuf:proto_api_python_headers.patch",
    ],
    version = "32.1",
)

