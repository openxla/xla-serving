module(name = "xla_serving")

# go/keep-sorted start
bazel_dep(name = "abseil-cpp", version = "20260526.0")
bazel_dep(name = "abseil-py", version = "2.1.0", repo_name = "absl_py")
bazel_dep(name = "aspect_bazel_lib", version = "2.11.0")
bazel_dep(name = "bazel_features", version = "1.50.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "blake3", version = "1.8.2.bcr.1")
bazel_dep(name = "boringssl", version = "0.20250818.0")
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "grpc", version = "1.81.0")
bazel_dep(name = "highway", version = "1.3.0", repo_name = "com_google_highway")
bazel_dep(name = "lz4", version = "1.10.0.bcr.1")
bazel_dep(name = "nanobind_bazel", version = "2.12.0")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "32.1", repo_name = "com_google_protobuf")
bazel_dep(name = "pybind11_abseil", version = "202402.0")
bazel_dep(name = "pybind11_bazel", version = "3.0.1")
bazel_dep(name = "pybind11_protobuf", version = "0.0.0-20250210-f02a2b7")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1")
bazel_dep(name = "riegeli", version = "0.0.0-20250822-9f2744d")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_oci", version = "1.7.2")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "snappy", version = "1.2.2.bcr.3")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")
# go/keep-sorted end

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "org_blosc_cblosc",
    build_file = "//:cblosc.BUILD.bazel",
    sha256 = "339b6b42a72991314abf9fbadaeff0c34955c1fafa1710fdfcef45d1bc03c030",
    strip_prefix = "c-blosc-c8072c21dcce8daf6dd19a0bbae8c53458ad68cc",
    urls = ["https://github.com/Blosc/c-blosc/archive/c8072c21dcce8daf6dd19a0bbae8c53458ad68cc.tar.gz"],
)

http_archive(
    name = "tensorstore",
    integrity = "sha256-bn5EENBIZYRdFFzXWEtW7eDFyGAk4FxPuGzAm5Z34F8=",
    strip_prefix = "tensorstore-2268931b0ff74d322b95632d11d8db7d6dda280f",
    urls = ["https://github.com/google/tensorstore/archive/2268931b0ff74d322b95632d11d8db7d6dda280f.tar.gz"],
)

http_archive(
    name = "net_sourceforge_half",
    build_file_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")
cc_library(
    name = "half",
    hdrs = ["include/half.hpp"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "76ddbf406e9d9b772ec73af2bf925b38b290b4390cc4064720a08d4b4bca0aa9",
    urls = ["https://sourceforge.net/projects/half/files/half/2.2.1/half-2.2.1.zip"],
)

# To calculate integrity:
# wget -O temp_module_archive.tar.gz <archive URL>
# HASH=$(openssl dgst -sha256 -binary temp_module_archive.tar.gz | openssl base64 -A)
# echo "sha256-${HASH}"
bazel_dep(name = "rules_ml_toolchain")
archive_override(
    module_name = "rules_ml_toolchain",
    integrity = "sha256-izPVqzV2I7ox7EYzRzcRY6ogeLcHUr4LRP2xMrkWh6A=",
    patch_strip = 1,
    patches = [
        "//third_party/rules_ml_toolchain:patch_nvcc_wrapper.patch",
    ],
    strip_prefix = "rules_ml_toolchain-236a498d8624bef88e35ce2518a833204b0db19f",
    urls = ["https://github.com/google-ml-infra/rules_ml_toolchain/archive/236a498d8624bef88e35ce2518a833204b0db19f.tar.gz"],
)

bazel_dep(name = "xla")
archive_override(
    module_name = "xla",
    integrity = "sha256-UpKIT3NlatWWU3WkHSH3h2GCne5z2Xj6QdCegHPaK/o=",
    patch_strip = 1,
    patches = [
        "//third_party/xla:xla_bzlmod_llvm.patch",
        "//third_party/xla:xla_python_3_12.patch",
    ],
    strip_prefix = "xla-7c3dd1936addd297d7c6fa46f6183986fc4160c3",
    urls = ["https://github.com/openxla/xla/archive/7c3dd1936addd297d7c6fa46f6183986fc4160c3.tar.gz"],
)

xla_third_party = use_extension("@xla//third_party/extensions:third_party.bzl", "third_party_ext")

override_repo(
    xla_third_party,
    riegeli = "riegeli",
)

## Tensorflow dependencies for common runtime, Tensor etc.
# To calculate integrity:
# wget -O temp_module_archive.zip
# HASH=$(openssl dgst -sha256 -binary temp_module_archive.zip | openssl base64 -A)
# echo "sha256-${HASH}"
bazel_dep(name = "tensorflow", repo_name = "org_tensorflow")
archive_override(
    module_name = "tensorflow",
    integrity = "sha256-IJv1DfwWkZi0pDqkXRZ0sAJRF309BYxlVxfKT6L8K1A=",
    patch_strip = 1,
    patches = [
        "//third_party/tensorflow:where_op_gpu.patch",
        # Newer Clang (e.g. Apple Clang 21) requires the `template`
        # disambiguator for these member-template calls; older compilers
        # accepted them without it.
        "//third_party/tensorflow:register_span_template_keyword.patch",
    ],
    strip_prefix = "tensorflow-bf9294b7ddba0380f22c85cfb87310f586747059",
    urls = ["https://github.com/tensorflow/tensorflow/archive/bf9294b7ddba0380f22c85cfb87310f586747059.zip"],
)

tf_third_party = use_extension("@org_tensorflow//third_party/extensions:third_party.bzl", "third_party_ext")
use_repo(tf_third_party, "tf_runtime")

single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = ["//third_party/grpc:grpc.patch"],
    version = "1.81.0",
)

single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = [
        # These patches are in XLA repo as well, we need to still
        # apply them here for build to succeed.
        "//third_party/protobuf:protobuf_arena.patch",
        "//third_party/protobuf:fix_message_lite_incomplete_type.patch",
        # The following patch is needed to fix package loading for `bazel query "deps(//xla/...)"`.
        "//third_party/protobuf:fix_python_dist_package.patch",
    ],
    version = "32.1",
)

##############################################################
# Dependencies defined in XLA via module extensions
##############################################################

### TSL
tsl_extension = use_extension("@xla//third_party/extensions:tsl.bzl", "tsl_extension")
use_repo(tsl_extension, "tsl")

### LLVM
llvm = use_extension("@xla//third_party/extensions:llvm.bzl", "llvm_extension")
use_repo(llvm, "llvm-project")

### C++ dependencies
third_party = use_extension("@xla//third_party/extensions:third_party.bzl", "third_party_ext")
use_repo(
    third_party,
    "dlpack",
    "eigen_archive",
    "highwayhash",
    "shardy",
    "stablehlo",
)

python_version_ext = use_extension("@xla//third_party/extensions:python_version.bzl", "python_version_ext")
use_repo(python_version_ext, "python_version_repo")

##############################################################
# OCI for building C++ runtime images
##############################################################

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc",
    digest = "sha256:6970a2b2cb07c68f3e15d1b5d2ba857e53da911d5d321f48a842d6b0d26984cf",
    image = "gcr.io/distroless/cc-debian12",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_cc")

oci.pull(
    name = "cuda_base",
    digest = "sha256:067e36448f34b1d5ef6986508e9745ae41a8d261c84050044409731cb0f1cf20",
    image = "docker.io/nvidia/cuda",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
use_repo(oci, "cuda_base")

##############################################################
# Dependencies defined in rules_ml_toolchain
##############################################################
nccl_configure = use_extension("@rules_ml_toolchain//extensions:nccl_configure.bzl", "nccl_configure_ext")
use_repo(nccl_configure, "local_config_nccl")

sycl_configure = use_extension("@rules_ml_toolchain//extensions:sycl_configure.bzl", "sycl_configure_ext")
use_repo(sycl_configure, "local_config_sycl")

nccl_redist = use_extension("@rules_ml_toolchain//extensions:nccl_redist.bzl", "nccl_redist_ext")
use_repo(nccl_redist, "cuda_nccl")

### CUDA dependencies
cuda_configure = use_extension("@rules_ml_toolchain//extensions:cuda_configure.bzl", "cuda_configure_ext")
use_repo(cuda_configure, "local_config_cuda")

cuda_json_ext = use_extension("@rules_ml_toolchain//extensions:cuda_json.bzl", "cuda_json_ext")
use_repo(cuda_json_ext, "cuda_redist_json")

cuda_redist_init_ext = use_extension("@rules_ml_toolchain//extensions:cuda_redist_init.bzl", "cuda_redist_init_ext")
use_repo(
    cuda_redist_init_ext,
    "cuda_crt",
    "cuda_cublas",
    "cuda_cudart",
    "cuda_cudnn",
    "cuda_cufft",
    "cuda_cupti",
    "cuda_curand",
    "cuda_cusolver",
    "cuda_cusparse",
    "cuda_driver",
    "cuda_nvcc",
    "cuda_nvdisasm",
    "cuda_nvjitlink",
    "cuda_nvml",
    "cuda_nvrtc",
    "cuda_nvtx",
    "cuda_nvvm",
)

nvshmem_redist = use_extension("@rules_ml_toolchain//extensions:nvshmem_redist.bzl", "nvshmem_redist_ext")
use_repo(nvshmem_redist, "nvidia_nvshmem")

# Use the newer version of cuda_cccl from XLA
cccl_extension = use_extension("@xla//third_party/cccl:cccl_extension.bzl", "cccl_extension")
use_repo(cccl_extension, "cuda_cccl")

override_repo(
    cuda_redist_init_ext,
    cuda_cccl = "cuda_cccl",
)

### Toolchains
toolchain_ext = use_extension("@rules_ml_toolchain//extensions:toolchain.bzl", "toolchain_ext")
use_repo(toolchain_ext, "llvm18_linux_x86_64", "llvm_linux_x86_64")

register_toolchains("@rules_ml_toolchain//cc:linux_x86_64_linux_x86_64")

register_toolchains("@rules_ml_toolchain//cc:linux_x86_64_linux_x86_64_cuda")

register_toolchains("@rules_ml_toolchain//cc:linux_aarch64_linux_aarch64")

register_toolchains("@rules_ml_toolchain//cc:linux_aarch64_linux_aarch64_cuda")

register_toolchains("@rules_ml_toolchain//cc:linux_x86_64_linux_x86_64_sycl")

### Other local config repos
local_clang_configure = use_extension("@rules_ml_toolchain//extensions:local_clang_configure.bzl", "local_clang_configure_ext")
use_repo(local_clang_configure, "local_config_clang")

single_version_override(
    module_name = "rules_python",
    patch_strip = 1,
    patches = [
        "//third_party/py:rules_python_pip_version.patch",
        "//third_party/py:rules_python_freethreaded.patch",
        "//third_party/py:rules_python_versions.patch",
        "//third_party/py:rules_python_scope.patch",
        "//third_party/py:rules_python_airlock.patch",
    ],
    version = "1.8.5",
)

### Toolchains

# TODO: Support HERMETIC_PYTHON_URL, etc to allow specifying a custom built
# python version.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(
    # The environment variable takes precedence if set.
    python_version = "3.11",
    python_version_env = "HERMETIC_PYTHON_VERSION",
)
python.toolchain(python_version = "3.11")
python.toolchain(python_version = "3.12")
python.toolchain(python_version = "3.13")

# Python dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

SUPPORTED_PYTHON_VERSIONS = [
    "3.11",
    "3.12",
    "3.13",
]

[
    pip.parse(
        hub_name = "xla_serving_pypi",
        python_version = version,
        requirements_lock = "//:requirements_lock_" + version + ".txt",
    )
    for version in SUPPORTED_PYTHON_VERSIONS
]

use_repo(pip, "xla_serving_pypi")

single_version_override(
    module_name = "highway",
    patch_strip = 1,
    patches = [
        "//third_party/com_google_highway:build.patch",
    ],
)

single_version_override(
    module_name = "abseil-cpp",
    patch_strip = 1,
    patches = [
        "//third_party/absl:btree.patch",
        "//third_party/absl:build_dll.patch",
        "//third_party/absl:endian.patch",
        "//third_party/absl:options.patch",
    ],
    version = "20260526.0",
)

single_version_override(
    module_name = "pybind11_abseil",
    patch_strip = 1,
    patches = [
        # status.so and ok_status_singleton.so are plain cc_binary targets
        # (not pybind_extension), so they miss the macOS
        # "-undefined dynamic_lookup" linkopt needed to leave CPython
        # symbols unresolved until the module is loaded into the
        # interpreter.
        "//third_party/pybind11_abseil:macos_undefined_dynamic_lookup.patch",
    ],
    version = "202402.0",
)
