common --enable_bzlmod
common --incompatible_disallow_empty_glob=false

# gRPC's src/core/BUILD requests features = ["layering_check"], and Clang's
# module-based strict decluse check doesn't correctly attribute ownership of
# protobuf's generated upb headers (e.g. google/protobuf/duration.upb.h) to
# their owning module even when that module is a declared "use" dependency,
# so it hard-errors on Clang toolchains that implement the feature (Xcode
# Clang locally, and the hermetic Clang toolchain used elsewhere). The
# feature is disabled by default everywhere and only activates because gRPC
# explicitly requests it, so turning it off globally is safe.
common --features=-layering_check

common --incompatible_enable_cc_toolchain_resolution
common --repo_env USE_HERMETIC_CC_TOOLCHAIN=1
common --repo_env SYSROOT_DIST=linux_glibc_2_31
common --@rules_ml_toolchain//common:stdlib=libc++
common --@rules_ml_toolchain//common:static_libcxx=true

# Apple Clang >=16 (Xcode CLT) hard-errors on aligned new/delete for the
# Bazel-default -mmacosx-version-min=10.11; over-aligned XLA types (e.g.
# xla::Literal) need aligned allocation, which requires macOS >=10.13.
# arm64 macOS requires >=11.0 anyway, so use that as the floor.
build --macos_minimum_os=11.0
build --host_macos_minimum_os=11.0

common --define=PREFIX=/usr
common --define=LIBDIR=$(PREFIX)/lib
common --define=INCLUDEDIR=$(PREFIX)/include
common --define=PROTOBUF_INCLUDE_PATH=$(PREFIX)/include

# Default Python toolchain configuration (Python 3.12)
common --@rules_python//python/config_settings:python_version=3.12

# TODO: Migrate for https://github.com/bazelbuild/bazel/issues/7260
common:clang_local --noincompatible_enable_cc_toolchain_resolution
common:clang_local --@rules_ml_toolchain//common:enable_hermetic_cc=False
common:clang_local --repo_env USE_HERMETIC_CC_TOOLCHAIN=0


# CUDA: This config refers to building CUDA op kernels with nvcc.
# This flag is needed to include CUDA libraries.
common:cuda --repo_env TF_NEED_CUDA=1
common:cuda --define=no_nccl_support=true
common:cuda --@local_config_cuda//:enable_cuda
common:cuda --@local_config_cuda//cuda:include_cuda_libs=true
common:cuda --@cuda_driver//:include_cuda_umd_libs=true
common:cuda --@local_config_cuda//cuda:override_include_cuda_libs=true
build:cuda --copt=-Wno-unused-command-line-argument
build:cuda --copt=-Wno-gnu-offsetof-extensions

# NVCC only supports GNU libstdc++ on Linux. Use glibc 2.35 sysroot which provides
# GCC 12 libstdc++ with full C++20 support (required by Abseil and Tensorstore).
common:cuda --repo_env SYSROOT_DIST=linux_glibc_2_35
common:cuda --@rules_ml_toolchain//common:stdlib=libstdc++
common:cuda --@rules_ml_toolchain//common:static_libcxx=false

# CUDA 12 with clang
common:cuda_v12_clang --config=cuda
common:cuda_v12_clang --repo_env=HERMETIC_CUDA_VERSION="12.9.1"
common:cuda_v12_clang --repo_env=HERMETIC_CUDNN_VERSION="9.8.0"
common:cuda_v12_clang --repo_env=HERMETIC_NVSHMEM_VERSION="3.3.9"
common:cuda_v12_clang --repo_env=HERMETIC_NCCL_VERSION="2.29.7"
common:cuda_v12_clang --repo_env HERMETIC_CUDA_COMPUTE_CAPABILITIES="sm_50,sm_60,sm_70,sm_80,sm_90"
# common CUDA and other C++ targets with Clang
common:cuda_v12_clang --@local_config_cuda//:cuda_compiler=clang


# CUDA 12 with nvcc: It can support more cuda compute capabilities for newer
# GPUs. This is the default for JAX and XLA as well.
common:cuda_v12 --config=cuda
common:cuda_v12 --repo_env=HERMETIC_CUDA_VERSION="12.9.1"
common:cuda_v12 --repo_env=HERMETIC_CUDA_UMD_VERSION="13.1.1"
common:cuda_v12 --repo_env=HERMETIC_CUDNN_VERSION="9.8.0"
common:cuda_v12 --repo_env=HERMETIC_NVSHMEM_VERSION="3.3.9"
common:cuda_v12 --repo_env=HERMETIC_NCCL_VERSION="2.29.7"
common:cuda_v12 --repo_env HERMETIC_CUDA_COMPUTE_CAPABILITIES="sm_50,sm_60,sm_70,sm_80,sm_90,sm_100,compute_120"
# common CUDA and other C++ targets with nvcc
common:cuda_v12 --action_env=TF_NVCC_CLANG="1"
common:cuda_v12 --@local_config_cuda//:cuda_compiler=nvcc


common:cuda_v13 --config=cuda
common:cuda_v13 --repo_env=HERMETIC_CUDA_VERSION="13.0.0"
common:cuda_v13 --repo_env=HERMETIC_CUDNN_VERSION="9.12.0"
common:cuda_v13 --repo_env=HERMETIC_CUDA_UMD_VERSION="13.1.1"
common:cuda_v13 --repo_env=HERMETIC_NCCL_VERSION="2.29.7"
common:cuda_v13 --repo_env=HERMETIC_NVSHMEM_VERSION="3.3.20"
common:cuda_v13 --repo_env=HERMETIC_CUDA_COMPUTE_CAPABILITIES="sm_75,sm_80,sm_90,sm_100,compute_120"
# common CUDA and other C++ targets with nvcc
common:cuda_v13 --action_env=TF_NVCC_CLANG="1"
common:cuda_v13 --@local_config_cuda//:cuda_compiler=nvcc

common --experimental_repo_remote_exec

# Do not use C-Ares when building gRPC.
common --define=grpc_no_ares=true

common --define=tsl_link_protobuf=true

common --repository_cache=~/.bazel_repository_cache

# Make action keys independent of the client environment (e.g. $PATH) so that
# the remote cache in `gs://xse-bazel-cache` is shared across CI runs and
# developer machines instead of being re-populated on every build.
build --incompatible_strict_action_env

# Always compile PIC code. In opt mode, Bazel by default builds both PIC (.pic.o)
# and non-PIC (.o) object files for shared libraries vs binaries/tests, which
# compiles shared C++ dependencies (XLA, LLVM, MLIR, TensorFlow, TensorStore)
# twice and prevents cc_test targets from reusing remote cache entries produced
# by Python shared library builds.
build --force_pic

# Required by Abseil and Tensorstore to prevent compilation errors
# (e.g. InstantiateRawHashMap not found) and ensure correct ABI compatibility.
build --cxxopt=-std=c++20
build --cxxopt=-fsized-deallocation
build --copt=-D_LIBCPP_ENABLE_CXX20_REMOVED_TYPE_TRAITS=1
build --copt=-D_LIBCPP_ENABLE_CXX20_REMOVED_FEATURES=1
build --host_copt=-D_LIBCPP_ENABLE_CXX20_REMOVED_TYPE_TRAITS=1
build --host_copt=-D_LIBCPP_ENABLE_CXX20_REMOVED_FEATURES=1

# XLA Serving Data.
build --copt=-DPYBIND11_ABSEIL_STATUS_MODULE_PATH=xla_serving_data.pybind11_abseil.status

# GCS Remote Cache configs (xse-bazel-cache)
common:remote_cache --remote_cache="https://storage.googleapis.com/xse-bazel-cache/"
common:remote_cache --remote_download_outputs=toplevel
common:remote_cache --remote_max_connections=128
common:remote_cache --remote_retries=3
common:remote_cache --remote_timeout=60
common:remote_cache --remote_cache_compression=true
common:remote_cache_readonly --config=remote_cache --remote_upload_local_results=false
common:remote_cache_readwrite --config=remote_cache --remote_upload_local_results=true --google_default_credentials

