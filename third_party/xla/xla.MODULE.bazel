# XLA dependency for XLA Serving, included from //:MODULE.bazel.
#
# The revision below is updated automatically to the latest green XLA commit.
# Keep this file limited to the XLA pin: the time of the last change to this
# file is used to decide whether the pin is older than the latest green commit.
#
# To update manually, set the commit in `strip_prefix` and `urls`, and compute
# `integrity` with:
#   curl -sL https://github.com/openxla/xla/archive/<commit>.tar.gz \
#     | openssl dgst -sha256 -binary | openssl base64 -A

bazel_dep(name = "xla")
archive_override(
    module_name = "xla",
    integrity = "sha256-o3mvqs7px5afcH4RJkb73KvidRSmi1Pm8o85To/IoaQ=",
    strip_prefix = "xla-b877c5f50a17ccce9b9cc11a6c2f4d6269b58d4a",
    urls = ["https://github.com/openxla/xla/archive/b877c5f50a17ccce9b9cc11a6c2f4d6269b58d4a.tar.gz"],
)
